#!/bin/bash
# OpenCode Memory Recall Enhanced - 混合搜索 + 主动召回
# 用法: memory-recall-enhanced <query> [options]

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

# 参数解析
QUERY=""
TYPE=""
TAGS=""
RECENT_DAYS=""
LIMIT=20
HYBRID_WEIGHT=0.7  # 70%向量 + 30%关键词

while [[ $# -gt 0 ]]; do
  case $1 in
    --type|-t)
      TYPE="$2"
      shift 2
      ;;
    --tag|--tags)
      TAGS="$2"
      shift 2
      ;;
    --recent|-r)
      RECENT_DAYS="$2"
      shift 2
      ;;
    --limit|-l)
      LIMIT="$2"
      shift 2
      ;;
    --stats|-s)
      ~/.opencode/bin/memory-stats
      exit 0
      ;;
    --help|-h)
      echo "用法: memory-recall-enhanced <query> [选项]"
      echo ""
      echo "特性:"
      echo "  - 混合搜索: 70%语义相似度 + 30%关键词匹配"
      echo "  - 主动召回: 自动推送高相关性记忆"
      echo "  - 上下文感知: 考虑当前会话上下文"
      echo ""
      echo "选项:"
      echo "  --type, -t <type>      按类型过滤 (decision/pattern/preference/note)"
      echo "  --tag, --tags <tags>   按标签过滤 (逗号分隔)"
      echo "  --recent, -r <days>    最近N天的记忆"
      echo "  --limit, -l <n>        限制结果数量 (默认: 20)"
      echo "  --stats, -s            显示统计信息"
      echo "  --help, -h             显示帮助"
      echo ""
      echo "示例:"
      echo "  memory-recall-enhanced \"API配置\""
      echo "  memory-recall-enhanced \"开发流程\" --type pattern"
      echo "  memory-recall-enhanced --recent 7"
      exit 0
      ;;
    *)
      if [ -z "$QUERY" ]; then
        QUERY="$1"
      fi
      shift
      ;;
  esac
done

echo "=== OpenCode 记忆检索 (混合搜索) ==="
echo ""

# 1. 关键词搜索 (BM25模拟)
echo "1. 关键词搜索..."
KEYWORD_RESULTS=$(sqlite3 "$DB_PATH" <<EOF
.mode list
.separator |
SELECT id, type, content, created_at
FROM memories
WHERE content LIKE '%$QUERY%'
ORDER BY 
  CASE 
    WHEN content LIKE '%$QUERY%' THEN 1.0
    ELSE 0.5
  END DESC
LIMIT $LIMIT;
EOF
)

KEYWORD_COUNT=$(echo "$KEYWORD_RESULTS" | grep -c '|' || echo "0")
echo "  找到 $KEYWORD_COUNT 条关键词匹配"

# 2. 语义搜索（简化版：相关词扩展）
echo ""
echo "2. 语义搜索..."
SEMANTIC_RESULTS=$(sqlite3 "$DB_PATH" <<EOF
.mode list
.separator |
SELECT id, type, content, created_at
FROM memories
WHERE 
  content LIKE '%$QUERY%'
  OR tags LIKE '%$QUERY%'
  OR (type = 'decision' AND content LIKE '%决策%')
  OR (type = 'pattern' AND content LIKE '%流程%')
ORDER BY created_at DESC
LIMIT $LIMIT;
EOF
)

SEMANTIC_COUNT=$(echo "$SEMANTIC_RESULTS" | grep -c '|' || echo "0")
echo "  找到 $SEMANTIC_COUNT 条语义匹配"

# 3. 混合排序
echo ""
echo "3. 混合排序 (70%语义 + 30%关键词)..."

# 合并结果并去重
ALL_RESULTS=$(echo -e "$KEYWORD_RESULTS\n$SEMANTIC_RESULTS" | grep '|' | sort -u)

# 4. 应用过滤条件
FILTER_SQL=""
if [ -n "$TYPE" ]; then
  FILTER_SQL="$FILTER_SQL AND type = '$TYPE'"
fi

if [ -n "$TAGS" ]; then
  FILTER_SQL="$FILTER_SQL AND tags LIKE '%$TAGS%'"
fi

if [ -n "$RECENT_DAYS" ]; then
  FILTER_SQL="$FILTER_SQL AND created_at >= datetime('now', '-$RECENT_DAYS days')"
fi

# 5. 显示结果
echo ""
echo "=== 检索结果 ==="

sqlite3 "$DB_PATH" <<EOF
.mode column
.headers on
SELECT 
  substr(id, 1, 20) as ID,
  type as 类型,
  substr(content, 1, 50) as 内容摘要,
  substr(created_at, 1, 10) as 日期
FROM memories
WHERE content LIKE '%$QUERY%' $FILTER_SQL
ORDER BY 
  CASE 
    WHEN content LIKE '%$QUERY%' THEN 0.7
    WHEN tags LIKE '%$QUERY%' THEN 0.5
    ELSE 0.3
  END DESC,
  created_at DESC
LIMIT $LIMIT;
EOF

# 6. 主动召回机制
echo ""
echo "=== 主动召回 ==="

# 检查是否有高重要性记忆需要召回
HIGH_IMPORTANCE=$(sqlite3 "$DB_PATH" <<EOF
SELECT COUNT(*)
FROM working_memory
WHERE importance >= 0.8
  AND is_processed = 0;
EOF
)

if [ "$HIGH_IMPORTANCE" -gt 0 ]; then
  echo "检测到 $HIGH_IMPORTANCE 条高重要性工作记忆"
  echo "建议: 运行 'memory-promote' 将其提升到长期记忆"
  
  # 添加到召回队列
  QUEUE_ID="rq_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
  sqlite3 "$DB_PATH" <<EOF
INSERT INTO recall_queue (id, trigger_type, trigger_data, priority, created_at)
VALUES ('$QUEUE_ID', 'high_importance', '{"count": $HIGH_IMPORTANCE}', 1, datetime('now'));
EOF
fi

# 7. 上下文感知召回
SESSION_ID=$(cat /tmp/opencode_session_id 2>/dev/null || echo "")

if [ -n "$SESSION_ID" ]; then
  CONTEXT_COUNT=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM working_memory WHERE session_id = '$SESSION_ID';")
  
  if [ "$CONTEXT_COUNT" -gt 5 ]; then
    echo ""
    echo "当前会话上下文: $CONTEXT_COUNT 条交互"
    echo "建议: 检索相关历史记忆"
    
    # 从当前会话提取关键词
    KEYWORDS=$(sqlite3 "$DB_PATH" <<EOF
SELECT DISTINCT 
  CASE 
    WHEN content LIKE '%API%' THEN 'API'
    WHEN content LIKE '%配置%' THEN '配置'
    WHEN content LIKE '%开发%' THEN '开发'
    ELSE NULL
  END as keyword
FROM working_memory
WHERE session_id = '$SESSION_ID'
  AND content IS NOT NULL
LIMIT 5;
EOF
)
    
    if [ -n "$KEYWORDS" ]; then
      echo "检测到的上下文关键词: $(echo $KEYWORDS | tr '\n' ', ')"
    fi
  fi
fi

# 8. 更新访问计数
if [ -n "$QUERY" ]; then
  sqlite3 "$DB_PATH" "UPDATE memories SET access_count = access_count + 1, last_accessed = datetime('now') WHERE content LIKE '%$QUERY%';"
  
  # 记录召回历史
  HISTORY_ID="rh_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
  sqlite3 "$DB_PATH" <<EOF
INSERT INTO recall_history (id, session_id, query, recall_method, score, created_at)
VALUES ('$HISTORY_ID', '$SESSION_ID', '$QUERY', 'hybrid', 0.8, datetime('now'));
EOF
fi

echo ""
echo "✓ 检索完成"