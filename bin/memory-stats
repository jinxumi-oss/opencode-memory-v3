#!/bin/bash
# OpenCode Memory Stats Tool
# Usage: memory-stats [--by-type] [--by-tag] [--recent <days>]

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

# 参数解析
BY_TYPE=false
BY_TAG=false
RECENT_DAYS=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --by-type|-t)
      BY_TYPE=true
      shift
      ;;
    --by-tag|--tags)
      BY_TAG=true
      shift
      ;;
    --recent|-r)
      RECENT_DAYS="$2"
      shift 2
      ;;
    --help|-h)
      echo "用法: memory-stats [选项]"
      echo ""
      echo "选项:"
      echo "  --by-type, -t      按类型统计"
      echo "  --by-tag, --tags   按标签统计"
      echo "  --recent, -r <days>  最近N天统计"
      echo "  --help, -h         显示帮助"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

echo "=== OpenCode 记忆系统统计 ==="
echo ""

# 总体统计
TOTAL=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM memories;")
echo "总记忆数: $TOTAL"

if [ "$BY_TYPE" = true ]; then
  echo ""
  echo "按类型分布:"
  sqlite3 "$DB_PATH" <<'EOF'
.mode column
.headers on
SELECT 
  type as 类型,
  COUNT(*) as 数量,
  ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM memories), 1) || '%' as 占比
FROM memories
GROUP BY type
ORDER BY COUNT(*) DESC;
EOF
fi

if [ "$BY_TAG" = true ]; then
  echo ""
  echo "按标签分布:"
  sqlite3 "$DB_PATH" <<'EOF'
.mode column
.headers on
SELECT 
  CASE 
    WHEN tags IS NULL OR tags = '' THEN '(无标签)'
    ELSE tags
  END as 标签,
  COUNT(*) as 数量
FROM memories
GROUP BY tags
ORDER BY COUNT(*) DESC
LIMIT 10;
EOF
fi

if [ -n "$RECENT_DAYS" ]; then
  echo ""
  echo "最近 $RECENT_DAYS 天:"
  RECENT_COUNT=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM memories WHERE created_at >= datetime('now', '-$RECENT_DAYS days');")
  echo "  新增记忆: $RECENT_COUNT"
fi

# 时间分布
echo ""
echo "时间分布:"
sqlite3 "$DB_PATH" <<'EOF'
.mode column
.headers on
SELECT 
  date(created_at) as 日期,
  COUNT(*) as 数量
FROM memories
GROUP BY date(created_at)
ORDER BY created_at DESC
LIMIT 10;
EOF

# 访问统计
echo ""
echo "访问统计:"
sqlite3 "$DB_PATH" <<'EOF'
.mode column
.headers on
SELECT 
  '总访问次数' as 指标,
  SUM(access_count) as 值
FROM memories
UNION ALL
SELECT 
  '平均访问次数',
  ROUND(AVG(access_count), 2)
FROM memories
UNION ALL
SELECT 
  '最多访问次数',
  MAX(access_count)
FROM memories;
EOF