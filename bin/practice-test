#!/bin/bash
# OpenCode 记忆系统 v3.0 实践测试
# 模拟真实的用户-Agent对话场景

set -e

echo "=========================================="
echo "  OpenCode 记忆系统 v3.0 实践测试"
echo "=========================================="
echo ""

# 清理之前的测试数据
echo "准备测试环境..."
rm -f /tmp/opencode_session_id

echo ""
echo "=========================================="
echo "  场景1: 新会话 - API配置问题"
echo "=========================================="
echo ""

# 开始会话
echo ">>> 用户开始新会话"
~/.opencode/bin/session start

echo ""
echo ">>> 用户: 我的API密钥过期了，应该怎么处理？"
~/.opencode/bin/working-memory "我的API密钥过期了，应该怎么处理？" --role user --importance 0.7

echo ""
echo ">>> Agent: 建议您检查环境变量中的API配置，或重新生成密钥"
~/.opencode/bin/working-memory "建议您检查环境变量中的API配置，或重新生成密钥" --role assistant --importance 0.8

echo ""
echo ">>> 用户: 我用的是OpenAI的API，之前配置在.env文件中"
~/.opencode/bin/working-memory "我用的是OpenAI的API，之前配置在.env文件中" --role user --importance 0.6

echo ""
echo ">>> Agent: 决策：建议使用环境变量管理API密钥，避免硬编码"
~/.opencode/bin/working-memory "决策：建议使用环境变量管理API密钥，避免硬编码" --role assistant --importance 0.9

echo ""
echo ">>> 查看当前会话上下文"
~/.opencode/bin/session context

echo ""
echo ">>> 查看会话状态"
~/.opencode/bin/session status

echo ""
echo "=========================================="
echo "  场景2: 会话结束 - 层级同步测试"
echo "=========================================="
echo ""

echo ">>> 结束会话（自动触发层级同步）"
~/.opencode/bin/session end

echo ""
echo "=========================================="
echo "  场景3: 混合搜索测试"
echo "=========================================="
echo ""

echo ">>> 搜索: 'API'"
~/.opencode/bin/memory-recall-enhanced "API" --limit 5

echo ""
echo ">>> 搜索: '决策'"
~/.opencode/bin/memory-recall-enhanced "决策" --limit 5

echo ""
echo ">>> 按类型搜索: --type decision"
~/.opencode/bin/memory-recall-enhanced "" --type decision --limit 5

echo ""
echo "=========================================="
echo "  场景4: 新会话 - 开发流程讨论"
echo "=========================================="
echo ""

echo ">>> 开始新会话"
~/.opencode/bin/session start

echo ""
echo ">>> 用户: 我在开发一个新项目，应该遵循什么流程？"
~/.opencode/bin/working-memory "我在开发一个新项目，应该遵循什么流程？" --role user --importance 0.7

echo ""
echo ">>> Agent: 开发流程规则：需求分析 → 架构设计 → 实现开发 → 测试验证 → 部署上线"
~/.opencode/bin/working-memory "开发流程规则：需求分析 → 架构设计 → 实现开发 → 测试验证 → 部署上线" --role assistant --importance 0.9

echo ""
echo ">>> 用户: 我偏好使用敏捷开发方法"
~/.opencode/bin/working-memory "我偏好使用敏捷开发方法" --role user --importance 0.6

echo ""
echo ">>> Agent: 记录用户偏好：敏捷开发方法"
~/.opencode/bin/working-memory "记录用户偏好：敏捷开发方法" --role assistant --importance 0.8

echo ""
echo ">>> 结束会话"
~/.opencode/bin/session end

echo ""
echo "=========================================="
echo "  场景5: 上下文感知召回测试"
echo "=========================================="
echo ""

echo ">>> 开始新会话"
~/.opencode/bin/session start

echo ""
echo ">>> 用户: 我要开发一个API项目"
~/.opencode/bin/working-memory "我要开发一个API项目" --role user --importance 0.7

echo ""
echo ">>> 触发上下文感知召回（应该召回API相关记忆）"
~/.opencode/bin/memory-recall-enhanced "API开发" --recent 30

echo ""
echo ">>> 用户: 应该遵循什么开发流程？"
~/.opencode/bin/working-memory "应该遵循什么开发流程？" --role user --importance 0.8

echo ""
echo ">>> 触发上下文感知召回（应该召回开发流程相关记忆）"
~/.opencode/bin/memory-recall-enhanced "开发流程" --type pattern

echo ""
echo ">>> 结束会话"
~/.opencode/bin/session end

echo ""
echo "=========================================="
echo "  场景6: 统计和验证"
echo "=========================================="
echo ""

echo ">>> 记忆系统统计"
~/.opencode/bin/memory-stats

echo ""
echo ">>> 按类型统计"
~/.opencode/bin/memory-stats --by-type

echo ""
echo ">>> 架构完整性测试"
~/.opencode/bin/test-architecture

echo ""
echo "=========================================="
echo "  实践测试完成！"
echo "=========================================="