#!/bin/bash
# OpenCode Memory Store Tool
# Usage: memory-store <content> [--type <type>] [--tag <tags>]

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

# 参数解析
CONTENT=""
TYPE="note"
TAGS=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --type|-t)
      TYPE="$2"
      shift 2
      ;;
    --tag|--tags)
      TAGS="$2"
      shift 2
      ;;
    --help|-h)
      echo "用法: memory-store <content> [--type <type>] [--tag <tags>]"
      echo ""
      echo "选项:"
      echo "  --type, -t     记忆类型 (decision/pattern/preference/note, 默认: note)"
      echo "  --tag, --tags  标签 (逗号分隔)"
      echo "  --help, -h     显示帮助"
      echo ""
      echo "示例:"
      echo "  memory-store \"更换了API密钥\" --type decision --tag api,config"
      exit 0
      ;;
    *)
      if [ -z "$CONTENT" ]; then
        CONTENT="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$CONTENT" ]; then
  echo "错误: 缺少内容参数"
  echo "用法: memory-store <content> [--type <type>] [--tag <tags>]"
  exit 1
fi

# 生成ID
ID="mem_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
CREATED_AT=$(date -Iseconds)

# 计算内容hash
CONTENT_HASH=$(echo -n "$CONTENT" | sha256sum | head -c 16)

# 检查重复
DUPLICATE=$(sqlite3 "$DB_PATH" "SELECT id FROM memories WHERE content_hash = '$CONTENT_HASH' LIMIT 1;")

if [ -n "$DUPLICATE" ]; then
  echo "警告: 检测到重复内容 (ID: $DUPLICATE)"
  echo "记忆已存在，跳过存储"
  exit 0
fi

# 转义单引号
CONTENT_ESCAPED=$(echo "$CONTENT" | sed "s/'/''/g")

# 存储到数据库
sqlite3 "$DB_PATH" "INSERT INTO memories (id, type, source, tags, content, content_hash, created_at, access_count) VALUES ('$ID', '$TYPE', 'user', '$TAGS', '$CONTENT_ESCAPED', '$CONTENT_HASH', '$CREATED_AT', 0);"

echo "✓ 记忆已存储"
echo "  ID: $ID"
echo "  类型: $TYPE"
echo "  标签: $TAGS"
echo "  时间: $CREATED_AT"