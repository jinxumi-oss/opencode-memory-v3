#!/bin/bash
# OpenCode Session Manager - L0 状态层
# 用法: session <command> [options]
# 命令: start, end, status, context

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

command=${1:-"status"}

case $command in
  start)
    # 开始新会话
    SESSION_ID="sess_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
    STARTED_AT=$(date -Iseconds)
    
    sqlite3 "$DB_PATH" "INSERT INTO sessions (id, started_at, memory_count) VALUES ('$SESSION_ID', '$STARTED_AT', 0);"
    
    echo "✓ 会话已开始"
    echo "  会话ID: $SESSION_ID"
    echo "  开始时间: $STARTED_AT"
    
    # 保存到文件供其他工具使用
    echo "$SESSION_ID" > /tmp/opencode_session_id
    ;;
    
  end)
    # 结束当前会话
    SESSION_ID=$(cat /tmp/opencode_session_id 2>/dev/null || echo "")
    
    if [ -z "$SESSION_ID" ]; then
      echo "错误: 没有活动的会话"
      exit 1
    fi
    
    ENDED_AT=$(date -Iseconds)
    
    # 生成上下文摘要
    MEMORY_COUNT=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM working_memory WHERE session_id = '$SESSION_ID';")
    CONTEXT_SUMMARY="会话包含 $MEMORY_COUNT 条交互记录"
    
    sqlite3 "$DB_PATH" "UPDATE sessions SET ended_at = '$ENDED_AT', context_summary = '$CONTEXT_SUMMARY', memory_count = $MEMORY_COUNT WHERE id = '$SESSION_ID';"
    
    echo "✓ 会话已结束"
    echo "  会话ID: $SESSION_ID"
    echo "  交互记录: $MEMORY_COUNT 条"
    
    # 触发层级同步：将工作记忆提升到长期记忆
    echo "正在同步工作记忆到长期记忆..."
    ~/.opencode/bin/memory-promote --session "$SESSION_ID"
    
    rm /tmp/opencode_session_id
    ;;
    
  status)
    # 显示当前会话状态
    SESSION_ID=$(cat /tmp/opencode_session_id 2>/dev/null || echo "")
    
    if [ -z "$SESSION_ID" ]; then
      echo "当前无活动会话"
      echo ""
      echo "使用 'session start' 开始新会话"
      exit 0
    fi
    
    sqlite3 "$DB_PATH" <<EOF
.mode column
.headers on
SELECT 
  '会话ID' as 属性,
  '$SESSION_ID' as 值
UNION ALL
SELECT 
  '开始时间',
  started_at
FROM sessions
WHERE id = '$SESSION_ID'
UNION ALL
SELECT 
  '交互记录数',
  CAST(memory_count AS TEXT)
FROM sessions
WHERE id = '$SESSION_ID'
UNION ALL
SELECT 
  '持续时间',
  CAST((julianday(datetime('now')) - julianday(started_at)) * 24 * 60 AS TEXT) || ' 分钟'
FROM sessions
WHERE id = '$SESSION_ID';
EOF
    ;;
    
  context)
    # 显示当前会话的上下文
    SESSION_ID=$(cat /tmp/opencode_session_id 2>/dev/null || echo "")
    
    if [ -z "$SESSION_ID" ]; then
      echo "错误: 没有活动的会话"
      exit 1
    fi
    
    LIMIT=${2:-20}
    
    echo "=== 当前会话上下文 (最近 $LIMIT 条) ==="
    echo ""
    
    sqlite3 "$DB_PATH" <<EOF
.mode column
.headers on
SELECT 
  substr(created_at, 12, 8) as 时间,
  role as 角色,
  substr(content, 1, 80) as 内容
FROM working_memory
WHERE session_id = '$SESSION_ID'
ORDER BY created_at DESC
LIMIT $LIMIT;
EOF
    ;;
    
  --help|-h)
    echo "用法: session <command> [options]"
    echo ""
    echo "命令:"
    echo "  start       开始新会话"
    echo "  end         结束当前会话"
    echo "  status      显示当前会话状态"
    echo "  context [n] 显示当前会话上下文（最近n条，默认20）"
    echo "  --help      显示帮助"
    echo ""
    echo "示例:"
    echo "  session start"
    echo "  session context 10"
    echo "  session end"
    ;;
    
  *)
    echo "错误: 未知命令 '$command'"
    echo "使用 'session --help' 查看帮助"
    exit 1
    ;;
esac