#!/bin/bash
# OpenCode Memory Promote - 层级同步工具
# 将工作记忆提升到长期记忆
# 用法: memory-promote --session <session-id>

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

# 参数解析
SESSION_ID=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --session|-s)
      SESSION_ID="$2"
      shift 2
      ;;
    --help|-h)
      echo "用法: memory-promote --session <session-id>"
      echo ""
      echo "功能: 将工作记忆提升到长期记忆"
      echo "  - 提取高重要性的交互记录"
      echo "  - 自动分类并打标签"
      echo "  - 更新知识图谱"
      echo "  - 触发学习层分析"
      echo ""
      echo "选项:"
      echo "  --session, -s  会话ID"
      echo "  --help, -h     显示帮助"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$SESSION_ID" ]; then
  echo "错误: 缺少会话ID"
  exit 1
fi

echo "=== 层级同步: L0 → L1 → L2 ==="
echo ""

# 1. 提取高重要性的工作记忆
echo "1. 提取工作记忆..."
IMPORTANT_MEMORIES=$(sqlite3 "$DB_PATH" <<EOF
SELECT id, role, content, importance
FROM working_memory
WHERE session_id = '$SESSION_ID'
  AND importance >= 0.7
  AND is_processed = 0
ORDER BY importance DESC;
EOF
)

if [ -z "$IMPORTANT_MEMORIES" ]; then
  echo "  没有需要提升的工作记忆"
  exit 0
fi

MEMORY_COUNT=$(echo "$IMPORTANT_MEMORIES" | wc -l)
echo "  找到 $MEMORY_COUNT 条高重要性记忆"

# 2. 提升到长期记忆
echo ""
echo "2. 提升到长期记忆 (L1)..."

PROMOTED_COUNT=0

while IFS='|' read -r WM_ID ROLE CONTENT IMPORTANCE; do
  # 自动分类
  TYPE="note"
  TAGS=""
  
  # 简单分类规则
  if echo "$CONTENT" | grep -qiE "决策|决定|选择|选用"; then
    TYPE="decision"
    TAGS="decision"
  elif echo "$CONTENT" | grep -qiE "规则|流程|规范|模式"; then
    TYPE="pattern"
    TAGS="pattern"
  elif echo "$CONTENT" | grep -qiE "偏好|喜欢|习惯"; then
    TYPE="preference"
    TAGS="preference"
  fi
  
  # 生成ID
  MEMORY_ID="mem_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
  CREATED_AT=$(date -Iseconds)
  CONTENT_HASH=$(echo -n "$CONTENT" | sha256sum | head -c 16)
  
  # 转义单引号
  CONTENT_ESCAPED=$(echo "$CONTENT" | sed "s/'/''/g")
  
  # 存储到长期记忆
  sqlite3 "$DB_PATH" <<EOF
INSERT INTO memories (id, type, source, tags, content, content_hash, created_at, access_count)
VALUES ('$MEMORY_ID', '$TYPE', 'promoted', '$TAGS', '$CONTENT_ESCAPED', '$CONTENT_HASH', '$CREATED_AT', 1);

UPDATE working_memory SET is_processed = 1 WHERE id = '$WM_ID';
EOF
  
  PROMOTED_COUNT=$((PROMOTED_COUNT + 1))
  echo "  ✓ 提升: $CONTENT (类型: $TYPE)"
  
  # 3. 更新知识图谱（创建节点）
  NODE_ID="kn_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
  sqlite3 "$DB_PATH" <<EOF
INSERT INTO knowledge_nodes (id, type, name, description, memory_id, created_at)
VALUES ('$NODE_ID', '$TYPE', substr('$CONTENT_ESCAPED', 1, 50), '$CONTENT_ESCAPED', '$MEMORY_ID', '$CREATED_AT');
EOF
  
done <<< "$IMPORTANT_MEMORIES"

echo ""
echo "✓ 成功提升 $PROMOTED_COUNT 条记忆到L1层"

# 4. 触发学习层分析
echo ""
echo "3. 触发学习层分析 (L2)..."

# 记录学习事件
EVENT_ID="le_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
sqlite3 "$DB_PATH" <<EOF
INSERT INTO learning_events (id, event_type, details, created_at)
VALUES ('$EVENT_ID', 'memory_promoted', '{"session_id": "$SESSION_ID", "count": $PROMOTED_COUNT}', datetime('now'));
EOF

echo "  ✓ 学习事件已记录"

# 记录心跳
HEARTBEAT_ID="hb_$(date +%Y%m%d_%H%M%S)_$(head -c 4 /dev/urandom | xxd -p)"
sqlite3 "$DB_PATH" <<EOF
INSERT INTO heartbeats (id, component, status, metrics, timestamp)
VALUES 
  ('$HEARTBEAT_ID', 'L0', 'active', '{"promoted": $PROMOTED_COUNT}', datetime('now')),
  ('${HEARTBEAT_ID}_l1', 'L1', 'active', '{"received": $PROMOTED_COUNT}', datetime('now')),
  ('${HEARTBEAT_ID}_l2', 'L2', 'idle', '{"events": 1}', datetime('now'));
EOF

echo ""
echo "=== 层级同步完成 ==="