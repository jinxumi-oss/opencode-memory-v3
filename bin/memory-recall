#!/bin/bash
# OpenCode Memory Recall Tool
# Usage: memory-recall <query> [--type <type>] [--tag <tags>] [--recent <days>] [--limit <n>]

set -e

DB_PATH="$HOME/.opencode/memory/memory.db"

# 参数解析
QUERY=""
TYPE=""
TAGS=""
RECENT_DAYS=""
LIMIT=20

while [[ $# -gt 0 ]]; do
  case $1 in
    --type|-t)
      TYPE="$2"
      shift 2
      ;;
    --tag|--tags)
      TAGS="$2"
      shift 2
      ;;
    --recent|-r)
      RECENT_DAYS="$2"
      shift 2
      ;;
    --limit|-l)
      LIMIT="$2"
      shift 2
      ;;
    --stats|-s)
      sqlite3 "$DB_PATH" <<'EOF'
.mode column
.headers on
SELECT 
  '总数' as metric,
  COUNT(*) as value
FROM memories
UNION ALL
SELECT 
  '类型: decision',
  COUNT(*)
FROM memories
WHERE type = 'decision'
UNION ALL
SELECT 
  '类型: pattern',
  COUNT(*)
FROM memories
WHERE type = 'pattern'
UNION ALL
SELECT 
  '类型: preference',
  COUNT(*)
FROM memories
WHERE type = 'preference'
UNION ALL
SELECT 
  '类型: note',
  COUNT(*)
FROM memories
WHERE type = 'note';
EOF
      exit 0
      ;;
    --help|-h)
      echo "用法: memory-recall <query> [选项]"
      echo ""
      echo "选项:"
      echo "  --type, -t <type>      按类型过滤 (decision/pattern/preference/note)"
      echo "  --tag, --tags <tags>   按标签过滤 (逗号分隔)"
      echo "  --recent, -r <days>    最近N天的记忆"
      echo "  --limit, -l <n>        限制结果数量 (默认: 20)"
      echo "  --stats, -s            显示统计信息"
      echo "  --help, -h             显示帮助"
      echo ""
      echo "示例:"
      echo "  memory-recall \"API\""
      echo "  memory-recall \"规范\" --type pattern"
      echo "  memory-recall --recent 7"
      exit 0
      ;;
    *)
      if [ -z "$QUERY" ]; then
        QUERY="$1"
      fi
      shift
      ;;
  esac
done

# 构建SQL查询
WHERE_CLAUSES=()

if [ -n "$QUERY" ]; then
  WHERE_CLAUSES+=("content LIKE '%$QUERY%'")
fi

if [ -n "$TYPE" ]; then
  WHERE_CLAUSES+=("type = '$TYPE'")
fi

if [ -n "$TAGS" ]; then
  WHERE_CLAUSES+=("tags LIKE '%$TAGS%'")
fi

if [ -n "$RECENT_DAYS" ]; then
  WHERE_CLAUSES+=("created_at >= datetime('now', '-$RECENT_DAYS days')")
fi

# 构建完整查询
if [ ${#WHERE_CLAUSES[@]} -gt 0 ]; then
  WHERE_SQL="WHERE ${WHERE_CLAUSES[*]}"
else
  WHERE_SQL=""
fi

# 执行查询
sqlite3 "$DB_PATH" <<EOF
.mode column
.headers on
SELECT 
  substr(id, 1, 20) as id,
  type,
  substr(content, 1, 60) as content,
  created_at
FROM memories
$WHERE_SQL
ORDER BY created_at DESC
LIMIT $LIMIT;
EOF

# 更新访问计数
if [ -n "$QUERY" ]; then
  sqlite3 "$DB_PATH" "UPDATE memories SET access_count = access_count + 1, last_accessed = datetime('now') WHERE content LIKE '%$QUERY%';"
fi