      }
    },
    "unspecified-low": {
      "model": "glm-4.7",
      "options": {
        "temperature": 0.2,
        "maxTokens": 2048
      }
    },
    "unspecified-high": {
      "model": "qwen3.5-plus",
      "options": {
        "temperature": 0.3,
