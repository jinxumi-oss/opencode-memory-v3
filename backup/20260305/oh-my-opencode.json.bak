    "writing": {
      "model": "qwen3.5-plus",
      "options": {
        "temperature": 0.5,
        "maxTokens": 8192
      }
    }
  },
  "hooks": {
    "auto-diagnostic": {
      "enabled": true,
      "triggers": ["file_edit", "file_write"],
      "action": "lsp_diagnostics"
    },
    "todo-continuation": {
      "enabled": true,
      "triggers": ["session_start", "task_assigned"],
      "action": "load_pending_todos"
    },
    "verify-before-complete": {
      "enabled": true,
      "triggers": ["task_complete"],
      "action": "run_validation"
    },
    "auto-commit-check": {
      "enabled": true,
      "triggers": ["pre_commit"],
      "action": "verify_tests_pass"
    }
  },
  "skills": {
    "priority": ["user", "project", "builtin"],
    "autoLoad": ["ralph-loop", "git-master", "persistent-context"]
  },
  "experimental": {
    "autoVerify": true,
    "tightFeedbackLoops": true,
    "parallelAgents": true,
    "sessionPersistence": true,
    "contextPreservation": true,
    "deepScan": true,
    "scanOnStartup": true,
    "scanPatterns": ["**/*.rs", "**/Cargo.toml", "**/*.md", "**/*.json"],
    "gitHistoryDepth": 10,
    "cacheProjectContext": true
  }
}
