  "categories": {
    "visual-engineering": {
      "model": "qwen3.5-plus",
      "options": {
        "temperature": 0.5,
        "maxTokens": 8192
      }
    },
    "ultrabrain": {
      "model": "qwen3-max-2026-01-23",
      "options": {
        "temperature": 0.3,
        "maxTokens": 16384
      }
    },
    "deep": {
      "model": "glm-5",
      "options": {
        "temperature": 0.3,
        "maxTokens": 8192
      }
    },
    "artistry": {
      "model": "qwen3.5-plus",
      "options": {
        "temperature": 0.7,
        "maxTokens": 8192
      }
    },
    "quick": {
      "model": "glm-4.7",
      "options": {
        "temperature": 0.2,
