{
  "name": "@opencode/memory",
  "version": "4.0.0",
  "description": "OpenCode Memory System - Three-layer architecture with BM25 + Vector search",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "memory": "./dist/cli/index.js",
    "memory-store": "./dist/cli/store.js",
    "memory-recall": "./dist/cli/recall.js",
    "memory-session": "./dist/cli/session.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/cli/*.ts --outdir=dist --format=esm --platform=node --bundle",
    "dev": "tsx src/index.ts",
    "test": "tsx src/cli/index.ts stats",
    "migrate": "tsx src/migrate.ts",
    "recall": "tsx src/cli/index.ts recall",
    "store": "tsx src/cli/index.ts store",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.2.24",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ollama": "^0.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bun": "latest",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.27.4",
    "typescript": "^5.4.0"
  }
}
