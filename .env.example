# OpenCode 环境变量配置
# 复制此文件为 .env 并填入实际的API密钥

# OpenAI 配置（必需）
export OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic Claude 配置（可选）
export ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# 本地模型配置（可选）
export LOCAL_MODEL_URL="http://localhost:11434/v1"
export LOCAL_MODEL_NAME="llama3:8b"

# 备份路径
export OPENCODE_MEMORY_PATH="$HOME/.opencode/memory"
export OPENCODE_CACHE_PATH="$HOME/.opencode/cache"

# 使用方法：
# 1. 复制并编辑：
#    cp .env.example .env
#    nano .env
#
# 2. 添加到 ~/.bashrc 或 ~/.zshrc：
#    source ~/.opencode/.env
#
# 3. 重新加载配置：
#    source ~/.bashrc
